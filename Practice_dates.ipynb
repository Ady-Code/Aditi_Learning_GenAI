    "from datetime import datetime\n",
    "\n",
    "start = datetime(2026, 3, 6, 10, 0)\n",
    "end = datetime(2026, 3, 6, 12, 30)\n",
    "\n",
    "duration = end - start\n",
    "\n",
    "print(duration)\n",
    "print(duration.seconds)\n",
    "print(duration.total_seconds())"
   ]
